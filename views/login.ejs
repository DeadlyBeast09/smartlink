<%- include('partials/header', { title: 'shrtn — login' }) %>

<section class="auth-page">

  <div class="auth-card">

    <div class="auth-card__bar">
      <span class="auth-card__dot auth-card__dot--red"></span>
      <span class="auth-card__dot auth-card__dot--yellow"></span>
      <span class="auth-card__dot auth-card__dot--green"></span>

      <span class="auth-card__label">
        authentication.login
      </span>
    </div>

    <div class="auth-card__body">

      <p class="auth-card__eyebrow">
        authentication
      </p>

      <h1 class="auth-card__title">
        Login
      </h1>

      <p class="auth-card__subtitle">
        Sign in to access your dashboard and manage your short URLs.
      </p>

      <form
        action="/login"
        method="POST"
        class="auth-form"
      >

        <input
          type="email"
          name="email"
          placeholder="email@example.com"
          required
          class="auth-form__input"
        />

        <input
          type="password"
          name="password"
          placeholder="Enter your password"
          required
          class="auth-form__input"
        />

        <button
          type="submit"
          class="auth-form__button"
        >
          Login
        </button>

      </form>

      <div class="auth-card__footer">
        Don't have an account?
        <a href="/signup">Create one</a>
      </div>

    </div>

  </div>

</section>

<%- include('partials/footer') %>